{
  "name": "second-brain-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace @second-brain/desktop run dev",
    "test": "tsx --test packages/brain-core/src/*.test.ts packages/brain-ui/src/*.test.ts apps/desktop/src/test.ts && npm run test:dom",
    "test:dom": "tsx --tsconfig tsconfig.dom-test.json --test --test-force-exit apps/desktop/src/calendar-dom.test.tsx apps/desktop/src/calendar-e2e.test.tsx apps/desktop/src/today-routine-dom.test.tsx apps/desktop/src/inline-edit.test.tsx apps/desktop/src/day-schedule-view.test.tsx",
    "build": "npm --workspace @second-brain/desktop run build",
    "desktop:dev": "npm --workspace @second-brain/desktop run tauri:dev",
    "desktop:build": "npm --workspace @second-brain/desktop run tauri:build",
    "desktop:installer": "npm --workspace @second-brain/desktop run tauri:installer",
    "desktop:publisher-installer": "node scripts/build-publisher-installer.mjs",
    "rust:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "happy-dom": "^15.11.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
